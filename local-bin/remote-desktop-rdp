#!/bin/sh

# script to view and control the hyprland desktop of another machine on the
# local network over rdp. like remote-desktop, hypr-rdp only runs on the remote
# for the duration of the connection, but it listens on the network directly
# and is protected by a one-time password. the remote needs sshd, hypr-rdp and
# a running hyprland session
#
# by default the focused monitor of the remote is shared like with wayvnc and
# scaled to the viewer window, which distorts it when the aspect ratios differ.
# with -n hypr-rdp instead adds a headless monitor to the remote that always
# has the native size and scale of the viewer window, so nothing is scaled

usage() {
    echo "usage: ${0##*/} [-n] [user@]host [port]" >&2
    exit 1
}

native=
while getopts n opt; do
    case $opt in
    n) native=1 ;;
    *) usage ;;
    esac
done
shift $((OPTIND - 1))
[ -n "$1" ] || usage
host=$1
port=${2:-3389}

if [ -n "$native" ]; then
    scale=$(hyprctl monitors -j | jq -r '.[] | select(.focused).scale')
    display="--scale $scale"
    view=/dynamic-resolution
else
    # shellcheck disable=SC2016 # $mon is expanded on the remote, see below
    display='--output "$mon"'
    view=/smart-sizing
fi

# the ssh host may be an alias, the rdp client needs the real address
addr=$(ssh -G "$host" | awk '$1 == "hostname" { print $2 }')
pass=$(tr -dc 'A-Za-z0-9' </dev/urandom | head -c 32)

ctl=$(mktemp -u "${XDG_RUNTIME_DIR:-/tmp}/remote-desktop-rdp.XXXXXX")

cleanup() {
    [ -n "$waiter" ] && kill "$waiter" 2>/dev/null
    ssh -S "$ctl" -O exit "$host" 2>/dev/null
}
trap cleanup EXIT
trap 'exit 1' INT TERM HUP

# one authenticated connection that all following ssh calls are multiplexed over
ssh -M -S "$ctl" -fN "$host" || exit 1

# a hypr-rdp left over from a connection that did not end cleanly is replaced.
# the password goes into a file only the remote user can read
pwfile=$(echo "$pass" | ssh -S "$ctl" "$host" '
    while pkill -x -u "$(id -u)" hypr-rdp; do sleep 0.5; done
    pwfile=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/hypr-rdp.pass
    (umask 077 && cat >"$pwfile") && echo "$pwfile"')
[ -n "$pwfile" ] || exit 1

# the viewer sends physical scancodes, which hypr-rdp maps with the keymap of
# the remote hyprland (with a password, hypr-rdp 0.1.6 never gets to apply the
# client layout). so the xkb options only one of the two keyboards uses, e.g.
# the alt/win swap missing on a mac keyboard, are applied here. the scancodes
# (see sdl-freerdp3 /list:kbd-scancode) are decimal, as freerdp rejects remap
# entries longer than 10 characters
remote_opts=$(ssh -S "$ctl" "$host" '
    export HYPRLAND_INSTANCE_SIGNATURE=$(hyprctl instances -j | jq -r ".[0].instance")
    hyprctl getoption input:kb_options -j | jq -r .str')
local_opts=$(hyprctl devices -j | jq -r '.keyboards[] | select(.main).options')
kbd=/kbd:layout:0x0807
for opt in $(printf '%s\n' "$local_opts" "$remote_opts" | tr , '\n' | sort | uniq -u); do
    case $opt in
    caps:swapescape) kbd=$kbd,remap:58=1,remap:1=58 ;;
    altwin:swap_lalt_lwin) kbd=$kbd,remap:56=347,remap:347=56 ;;
    lv3:rwin_switch) kbd=$kbd,remap:348=312 ;;
    esac
done

# open the viewer as soon as hypr-rdp listens, it has read the password by then.
# the arguments come from stdin so that the password does not show up in ps.
# closing the viewer ends the connection
(
    until ssh -S "$ctl" "$host" "ss -Hltn 'sport = :$port' | grep -q ." 2>/dev/null; do
        sleep 0.5
    done
    ssh -S "$ctl" "$host" "rm -f '$pwfile'"
    printf '%s\n' "/v:$addr:$port" /u:rdp "/p:$pass" '/auth-pkg-list:!kerberos' \
        "$kbd" /cert:tofu /sound "$view" /log-level:ERROR |
        sdl-freerdp3 /args-from:stdin >/dev/null
    ssh -S "$ctl" -O exit "$host" 2>/dev/null
) &
waiter=$!

echo "Sharing the desktop of $host on rdp://$addr:$port (ctrl-c to stop)"

# -tt so that hypr-rdp gets hung up when this connection goes away, which also
# removes its headless monitor
ssh -S "$ctl" -tt "$host" "
    sig=\$(hyprctl instances -j | jq -re '.[0].instance') || {
        echo 'No running hyprland session found' >&2
        exit 1
    }
    export HYPRLAND_INSTANCE_SIGNATURE=\$sig
    export WAYLAND_DISPLAY=\$(hyprctl instances -j | jq -r '.[0].wl_socket')
    mon=\$(hyprctl monitors -j | jq -r '.[] | select(.focused).name')
    exec hypr-rdp --bind 0.0.0.0:$port --username rdp \
        --password-file '$pwfile' $display \
        --keyboard-layout-policy compositor"
