#!/bin/sh

# Re-pin the FHNW VPN gateway certificate
#
# vpn.fhnw.ch does not serve a complete certificate chain, so openconnect only
# accepts it through a public key pin stored in the NetworkManager connection.
# When FHNW rotates the certificate, connecting starts failing with
# 'Cookie was rejected by server' and the pin has to be replaced.
#
# A changed pin is either that rotation or somebody in the middle, so the old
# and the new value are shown and have to be confirmed. Pass -y to skip the
# confirmation, or -n to only report, which is what fhnw-vpn-up uses to tell a
# rotated certificate apart from any other failure:
#
#   0  the pin is unchanged
#   1  the pin changed
#   2  something went wrong, the gateway is probably unreachable

CONNECTION="fhnw"
GATEWAY="vpn.fhnw.ch"

check_only=0
force=0

error_msg() {
    echo "Error: $1" >&2
    exit 2
}

case "${1:-}" in
    -n | --check) check_only=1 ;;
    -y) force=1 ;;
    "") ;;
    *)
        echo "Usage: ${0##*/} [-y | -n]" >&2
        exit 2
        ;;
esac

stored_pin() {
    # nmcli escapes the colon of the pin in its terse output
    nmcli --show-secrets -g vpn.secrets connection show "$CONNECTION" 2>/dev/null |
        tr ',' '\n' | sed -n 's/^ *gwcert = //p' | sed 's/\\:/:/g'
}

served_pin() {
    # Without the public key check this digests empty input, which hashes just
    # fine and would pin a certificate that was never served
    public_key=$(openssl s_client -connect "$GATEWAY:443" </dev/null 2>/dev/null |
        openssl x509 -pubkey -noout 2>/dev/null)
    [ -n "$public_key" ] || return 1

    printf '%s\n' "$public_key" | openssl pkey -pubin -outform der 2>/dev/null |
        openssl dgst -sha256 -binary | base64
}

command -v nmcli > /dev/null || error_msg "Could not find 'nmcli' executable"
command -v openssl > /dev/null || error_msg "Could not find 'openssl' executable"

nmcli -t -f NAME connection show | grep -qx "$CONNECTION" ||
    error_msg "No '$CONNECTION' connection configured in NetworkManager"

served="pin-sha256:$(served_pin)" || error_msg "Could not read the certificate of $GATEWAY"

stored=$(stored_pin)
if [ "$stored" = "$served" ]; then
    echo "The pin of $GATEWAY is unchanged, nothing to do"
    exit 0
fi

echo "stored: ${stored:-none}"
echo "served: $served"

[ "$check_only" -eq 0 ] || exit 1

if [ "$force" -eq 0 ]; then
    printf 'Replace the stored pin? [y/N] '
    read -r answer
    case "$answer" in
        [yY]*) ;;
        *)
            echo "Keeping the stored pin"
            exit 0
            ;;
    esac
fi

nmcli connection modify "$CONNECTION" +vpn.secrets "gwcert=$served" ||
    error_msg "Could not pin the certificate of $GATEWAY"

echo "Pinned the certificate of $GATEWAY"
